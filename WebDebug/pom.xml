<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>WebDebug</groupId>
  <artifactId>WebDebug</artifactId>
  <version>${revision}</version>

  <properties>
    <revision>0.0.1</revision>
  </properties>

  <dependencies>
    <dependency>
      <groupId>Expressoes1</groupId>
      <artifactId>Expressoes1</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Expressoes2</groupId>
      <artifactId>Expressoes2</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Funcional1</groupId>
      <artifactId>Funcional1</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Funcional2</groupId>
      <artifactId>Funcional2</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Funcional3</groupId>
      <artifactId>Funcional3</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Imperativa1</groupId>
      <artifactId>Imperativa1</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Imperativa2</groupId>
      <artifactId>Imperativa2</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Objetos1</groupId>
      <artifactId>Objetos1</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Objetos2</groupId>
      <artifactId>Objetos2</artifactId>
      <version>${revision}</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src</sourceDirectory>
    <resources>
      <resource>
        <directory>src</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.1</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>

      <!--
        Gramáticas próprias do WebDebug: cópias das gramáticas das linguagens
        cujas ações constroem subclasses Debug com a faixa exata de
        código-fonte. As gramáticas das linguagens não são alteradas.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>javacc-maven-plugin</artifactId>
        <version>2.6</version>
        <executions>
          <execution>
            <id>javacc-expressoes1</id>
            <goals><goal>javacc</goal></goals>
            <configuration>
              <sourceDirectory>${basedir}/src/plp/debug/expressoes1/parser</sourceDirectory>
            </configuration>
          </execution>
          <execution>
            <id>javacc-expressoes2</id>
            <goals><goal>javacc</goal></goals>
            <configuration>
              <sourceDirectory>${basedir}/src/plp/debug/expressoes2/parser</sourceDirectory>
            </configuration>
          </execution>
          <execution>
            <id>javacc-funcional1</id>
            <goals><goal>javacc</goal></goals>
            <configuration>
              <sourceDirectory>${basedir}/src/plp/debug/funcional1/parser</sourceDirectory>
            </configuration>
          </execution>
          <execution>
            <id>javacc-funcional2</id>
            <goals><goal>javacc</goal></goals>
            <configuration>
              <sourceDirectory>${basedir}/src/plp/debug/funcional2/parser</sourceDirectory>
            </configuration>
          </execution>
          <execution>
            <id>javacc-funcional3</id>
            <goals><goal>javacc</goal></goals>
            <configuration>
              <sourceDirectory>${basedir}/src/plp/debug/funcional3/parser</sourceDirectory>
            </configuration>
          </execution>
          <execution>
            <id>javacc-imperativa1</id>
            <goals><goal>javacc</goal></goals>
            <configuration>
              <sourceDirectory>${basedir}/src/plp/debug/imperativa1/parser</sourceDirectory>
            </configuration>
          </execution>
          <execution>
            <id>javacc-imperativa2</id>
            <goals><goal>javacc</goal></goals>
            <configuration>
              <sourceDirectory>${basedir}/src/plp/debug/imperativa2/parser</sourceDirectory>
            </configuration>
          </execution>
          <execution>
            <id>javacc-objetos1</id>
            <goals><goal>javacc</goal></goals>
            <configuration>
              <sourceDirectory>${basedir}/src/plp/debug/objetos1/parser</sourceDirectory>
            </configuration>
          </execution>
          <execution>
            <id>javacc-objetos2</id>
            <goals><goal>javacc</goal></goals>
            <configuration>
              <sourceDirectory>${basedir}/src/plp/debug/objetos2/parser</sourceDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>add-source</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>target/generated-sources/javacc</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
