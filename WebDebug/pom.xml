<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>WebDebug</groupId>
  <artifactId>WebDebug</artifactId>
  <version>${revision}</version>

  <properties>
    <revision>0.0.1</revision>
  </properties>

  <dependencies>
    <dependency>
      <groupId>Expressoes2</groupId>
      <artifactId>Expressoes2</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Funcional1</groupId>
      <artifactId>Funcional1</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Funcional2</groupId>
      <artifactId>Funcional2</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Funcional3</groupId>
      <artifactId>Funcional3</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Imperativa1</groupId>
      <artifactId>Imperativa1</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Imperativa2</groupId>
      <artifactId>Imperativa2</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Objetos1</groupId>
      <artifactId>Objetos1</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>Objetos2</groupId>
      <artifactId>Objetos2</artifactId>
      <version>${revision}</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src</sourceDirectory>
    <resources>
      <resource>
        <directory>src</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.1</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
